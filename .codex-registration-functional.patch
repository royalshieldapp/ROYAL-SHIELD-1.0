+
+private fun registrationErrorMessage(error: Throwable): String = when (error) {
+    is FirebaseAuthUserCollisionException -> "This email is already registered"
+    is FirebaseAuthWeakPasswordException -> "Choose a stronger password"
+    is FirebaseAuthInvalidCredentialsException -> "The email or password is invalid"
+    is FirebaseAuthInvalidUserException -> "No account exists for this email"
+    else -> error.message
+        ?.takeIf { it == "Verify your email before signing in" }
+        ?: "Authentication failed. Check your connection and try again"
+}
