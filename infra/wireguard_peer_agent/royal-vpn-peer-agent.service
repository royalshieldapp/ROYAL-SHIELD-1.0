[Unit]
Description=Royal VPN WireGuard Peer Agent
After=network-online.target wg-quick@wg0.service
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/royal-vpn-peer-agent.env
ExecStart=/usr/bin/python3 /opt/royal-vpn-peer-agent/peer_agent.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/wireguard /var/lib/royal-vpn
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
